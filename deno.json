{
  "name": "@ethanthatonekid/commentsh",
  "version": "0.2.0",
  "exports": "./commentsh.ts",
  "tasks": {
    "commentsh": "deno run --allow-read --allow-write --allow-run commentsh.ts",
    "docs:gen": "deno run --allow-read --allow-write --allow-run commentsh.ts README.md",
    "docs:check": "deno run --allow-read --allow-write --allow-run commentsh.ts --check README.md",
    "test": "deno test --allow-read --allow-write --allow-run",
    "lint": "deno lint",
    "fmt": "deno fmt"
  },
  "fmt": {
    "lineWidth": 100
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@std/fs": "jsr:@std/fs@^1.0.24"
  }
}
